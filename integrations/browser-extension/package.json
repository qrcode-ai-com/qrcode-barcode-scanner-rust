{
  "name": "qrcode-barcode-scanner-browser-extension",
  "version": "0.1.1",
  "private": true,
  "description": "Browser extension that reads QR codes and barcodes with the published WASM",
  "type": "module",
  "license": "MIT",
  "homepage": "https://qrcode-ai.com/en-US/qr-code-scanner/integrations/browser-extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/qrcode-ai-com/qrcode-barcode-scanner-rust.git",
    "directory": "integrations/browser-extension"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "config": {
    "wasmSha256": "298fd9df8bc23639d00cb8effd5f1d1a742db2f53866868aec21723468f08868"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build-for-amo": "node scripts/build.mjs",
    "check:pins": "node scripts/build.mjs --check",
    "pin": "node scripts/build.mjs --pin",
    "safari": "node scripts/safari.mjs",
    "store-images": "node scripts/store-images.mjs",
    "inspect": "node scripts/inspect.mjs build",
    "test": "node --test test/unit.test.mjs",
    "test:chromium": "node test/chromium.mjs",
    "test:firefox-addon": "node test/firefox-addon.mjs",
    "test:firefox-page": "node test/engine-page.mjs --browser firefox",
    "test:webkit-page": "node test/engine-page.mjs --browser webkit",
    "test:reproduce": "node test/reproduce.mjs",
    "lint:firefox": "node scripts/lint-firefox.mjs"
  },
  "dependencies": {
    "@qrcode-ai-com/qrcode-barcode-scanner-wasm": "0.12.0"
  },
  "devDependencies": {
    "playwright": "1.61.0",
    "web-ext": "10.8.0"
  }
}
