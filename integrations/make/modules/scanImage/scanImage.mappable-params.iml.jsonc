[
  {
    "name": "fileName",
    "type": "filename",
    "label": "File name",
    "required": true,
    "semantic": "file:name"
  },
  {
    "name": "data",
    "type": "buffer",
    "label": "Data",
    "required": true,
    "semantic": "file:data",
    "help": "A PNG, JPEG, WebP or GIF file, at most 8 MiB and 4096 pixels per side, unless the scan service sets other limits."
  },
  {
    "name": "mode",
    "type": "select",
    "label": "Profile",
    "required": true,
    "default": "fast",
    "help": "Fast, the default, decodes and gives a reduced QR score within 800 ms. Frame decodes without scoring within the 80 ms of a camera frame. Full gives the full QR score within 4000 ms.",
    "options": [
      { "label": "Fast: decode and give a reduced QR score (default)", "value": "fast" },
      { "label": "Frame: decode without scoring, for camera frames", "value": "frame" },
      { "label": "Full: decode and give the full QR score", "value": "full" }
    ]
  }
]
